<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification toggle — state selector
  state_checked=true → filled (notifications ON)
  default            → outlined (notifications OFF)
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true"   android:drawable="@drawable/ic_notification_filled"/>
    <item android:state_selected="true"  android:drawable="@drawable/ic_notification_filled"/>
    <item                                android:drawable="@drawable/ic_notification_outlined"/>
</selector>
