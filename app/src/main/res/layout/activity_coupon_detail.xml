<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.motion.widget.MotionLayout
            android:id="@+id/mlCouponDetail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
            app:layoutDescription="@xml/fragment_detail_coupon_xml_constraint_layout_scene"
            tools:context=".ui.detail.CouponDetailActivity">


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/m3_surface"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="@color/m3_error_container"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="2dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeWidth="0dp">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvTimeLeft"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:textColor="@color/m3_on_error_container"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvCourseTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="16dp"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/ivPreview"
                        tools:text="Facebook Ads Lead Generation Marketing for business" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvCourseAuthor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lines="1"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="@+id/tvCourseTitle"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="@+id/tvCourseTitle"
                        app:layout_constraintTop_toBottomOf="@+id/tvCourseTitle"
                        tools:text="Yasir Ahmed, M.B.A" />

                <com.thanh0x.coursedeals.ui.custom_view.ZoomableImageView
                    android:id="@+id/ivPreview"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:src="@color/m3_primary_container"
                    app:layout_constraintDimensionRatio="1.78"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/tvCourseCategory"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/m3_on_primary_container"
                        app:chipBackgroundColor="@color/m3_primary_container"
                        app:chipStrokeWidth="0dp"
                        app:layout_constraintStart_toStartOf="@+id/tvCourseAuthor"
                        app:layout_constraintTop_toBottomOf="@+id/tvCourseAuthor"
                        tools:text="Social Media Marketing" />

                    <RatingBar
                        android:id="@+id/rbCouponDetail"
                        style="@style/Widget.AppCompat.RatingBar.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:numStars="5"
                        android:theme="@style/rating_bar"
                        app:layout_constraintStart_toStartOf="@+id/tvCourseCategory"
                        app:layout_constraintTop_toBottomOf="@+id/tvCourseCategory" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvNumberOfStudent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/loading_student_text"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@+id/rbCouponDetail"
                        app:layout_constraintStart_toEndOf="@+id/rbCouponDetail"
                        app:layout_constraintTop_toTopOf="@+id/rbCouponDetail" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvNumberOfReview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/loading_review_text"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@+id/tvNumberOfStudent"
                        app:layout_constraintStart_toEndOf="@+id/tvNumberOfStudent"
                        app:layout_constraintTop_toTopOf="@+id/tvNumberOfStudent" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingHorizontal="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/rbCouponDetail">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="12dp"
                            android:orientation="horizontal"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/llCouponLeftContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_info_item"
                                android:backgroundTint="@color/m3_surface_container"
                                android:orientation="vertical"
                                android:padding="8dp">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/text_coupons_left"
                                    android:textAlignment="center"
                                    android:textColor="@color/m3_on_surface_variant"
                                    android:textSize="11sp" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/tvCouponLeft"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAlignment="center"
                                    android:textColor="@color/m3_on_surface"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="701" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/llCourseLengthContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_info_item"
                                android:backgroundTint="@color/m3_surface_container"
                                android:orientation="vertical"
                                android:padding="8dp">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/text_content_length"
                                    android:textAlignment="center"
                                    android:textColor="@color/m3_on_surface_variant"
                                    android:textSize="11sp" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/tvContentLength"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAlignment="center"
                                    android:textColor="@color/m3_on_surface"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="701" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/llCourseLevelContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_info_item"
                                android:backgroundTint="@color/m3_surface_container"
                                android:orientation="vertical"
                                android:padding="8dp">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/text_course_level"
                                    android:textAlignment="center"
                                    android:textColor="@color/m3_on_surface_variant"
                                    android:textSize="11sp" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/tvCourseLevel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAlignment="center"
                                    android:textColor="@color/m3_on_surface"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="701" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/llCourseLanguageContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_info_item"
                                android:backgroundTint="@color/m3_surface_container"
                                android:orientation="vertical"
                                android:padding="8dp">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/text_language"
                                    android:textAlignment="center"
                                    android:textColor="@color/m3_on_surface_variant"
                                    android:textSize="11sp" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/tvLanguage"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAlignment="center"
                                    android:textColor="@color/m3_on_surface"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="701" />
                            </LinearLayout>

                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </HorizontalScrollView>


                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/nsvCourseDetail"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                app:layout_constraintBottom_toTopOf="@id/llActionContainer"
                app:layout_constraintEnd_toEndOf="@+id/cvContainer"
                app:layout_constraintStart_toStartOf="@+id/cvContainer"
                app:layout_constraintTop_toBottomOf="@+id/cvContainer">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvCourseHeading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginTop="20dp"
                        android:text="@string/header_heading"
                        android:textColor="@color/headingTitle"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvCourseHeadingTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/primaryTextColor"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@+id/tvCourseHeading"
                        app:layout_constraintStart_toStartOf="@+id/tvCourseHeading"
                        app:layout_constraintTop_toBottomOf="@+id/tvCourseHeading" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/header_description"
                        android:textColor="@color/headingTitle"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@+id/tvCourseHeadingTitle"
                        app:layout_constraintStart_toStartOf="@+id/tvCourseHeading"
                        app:layout_constraintTop_toBottomOf="@+id/tvCourseHeadingTitle" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvCourseDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primaryTextColor"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@id/tvDescription"
                        app:layout_constraintStart_toStartOf="@+id/tvDescription"
                        app:layout_constraintTop_toBottomOf="@id/tvDescription"
                        tools:ignore="SmallSp" />
                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.core.widget.NestedScrollView>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/llActionContainer"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:background="@color/m3_surface"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShare"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/baseline_share_24"
                    app:iconTint="@color/m3_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenBrowser"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/text_button_open_browser"
                    android:textColor="@color/m3_primary"
                    app:icon="@drawable/baseline_open_in_browser_24"
                    app:iconTint="@color/m3_primary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnroll"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_button_enroll_now"
                    android:textSize="16sp"
                    app:cornerRadius="24dp" />

            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.motion.widget.MotionLayout>

        <ProgressBar
            android:id="@+id/pbLoadingCouponDetails"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias=".9"
            app:layout_constraintWidth_percent=".2" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
