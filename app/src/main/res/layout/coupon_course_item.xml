<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="coupon"
            type="com.thanh0x.coursedeals.domain.model.Coupon" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            app:cardBackgroundColor="@color/m3_surface_container"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvTimeLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    app:cardBackgroundColor="@color/m3_error_container"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="2dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeWidth="0dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvTimeLeft"
                        app:timeLeft="@{coupon.expiredDate}"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:textColor="@color/m3_on_error_container"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="3 days" />
                </com.google.android.material.card.MaterialCardView>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivCoursePreview"
                    app:loadImageFromUrl="@{coupon.previewImage}"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="@color/m3_primary_container"
                    app:layout_constraintDimensionRatio="1.78"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvCourseTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:lines="2"
                    android:text="@{coupon.title}"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivCoursePreview"
                    tools:text="Sample title here" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvCourseAuthor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:lines="1"
                    android:text="@{coupon.author}"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toEndOf="@+id/tvCourseTitle"
                    app:layout_constraintStart_toStartOf="@+id/tvCourseTitle"
                    app:layout_constraintTop_toBottomOf="@+id/tvCourseTitle"
                    tools:text="Author name" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvCourseCategory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@{coupon.category}"
                    android:textColor="@color/m3_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/tvCourseAuthor"
                    app:layout_constraintStart_toStartOf="@+id/tvCourseAuthor"
                    app:layout_constraintTop_toBottomOf="@+id/tvCourseAuthor"
                    tools:text="Development" />

                <RatingBar
                    android:id="@+id/rbCourse"
                    style="@style/Widget.AppCompat.RatingBar.Small"
                    app:displayRating="@{coupon.rating}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:numStars="5"
                    android:theme="@style/rating_bar"
                    app:layout_constraintStart_toStartOf="@+id/tvCourseCategory"
                    app:layout_constraintTop_toBottomOf="@+id/tvCourseCategory" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivStudents"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_students"
                    app:layout_constraintStart_toStartOf="@+id/rbCourse"
                    app:layout_constraintTop_toBottomOf="@+id/rbCourse"
                    app:tint="@color/m3_on_surface_variant" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvNumberOfStudent"
                    app:displayNumberOfStudents="@{coupon.students}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="10sp"
                    app:layout_constraintBottom_toBottomOf="@+id/ivStudents"
                    app:layout_constraintStart_toEndOf="@+id/ivStudents"
                    app:layout_constraintTop_toTopOf="@+id/ivStudents"
                    tools:text="2k" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivReviews"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_comment"
                    app:layout_constraintBottom_toBottomOf="@+id/ivStudents"
                    app:layout_constraintStart_toEndOf="@+id/tvNumberOfStudent"
                    app:layout_constraintTop_toTopOf="@+id/ivStudents"
                    app:tint="@color/m3_on_surface_variant" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvNumberOfReviews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="6dp"
                    android:text="@{String.valueOf(coupon.reviews)}"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="10sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivReviews"
                    app:layout_constraintTop_toTopOf="@+id/ivReviews"
                    tools:text="452" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>