<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="coupon"
            type="com.thanh0x.coursedeals.domain.model.Coupon" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_2"
            app:cardBackgroundColor="@color/m3_surface_container"
            app:cardCornerRadius="@dimen/course_item_radius"
            app:cardElevation="@dimen/elevation_low"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvTimeLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:layout_marginEnd="@dimen/spacing_4"
                    app:cardBackgroundColor="@color/m3_error_container"
                    app:cardCornerRadius="@dimen/corner_radius_small"
                    app:cardElevation="@dimen/elevation_medium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeWidth="0dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvTimeLeft"
                        app:timeLeft="@{coupon.expiredTime}"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/info_item_height_small"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_6"
                        android:textColor="@color/m3_on_error_container"
                        android:textSize="@dimen/text_size_label_small"
                        android:textStyle="bold"
                        tools:text="3 days" />
                </com.google.android.material.card.MaterialCardView>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivCoursePreview"
                    app:loadImageFromUrl="@{coupon.previewImage}"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="@color/m3_primary_container"
                    app:layout_constraintDimensionRatio="1.78"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvCourseTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_8"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:ellipsize="end"
                    android:lines="2"
                    android:text="@{coupon.title}"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="@dimen/text_size_title_small"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivCoursePreview"
                    tools:text="Sample title here" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvCourseAuthor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_1"
                    android:lines="1"
                    android:text="@{coupon.author}"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="@dimen/text_size_body_small"
                    app:layout_constraintEnd_toEndOf="@+id/tvCourseTitle"
                    app:layout_constraintStart_toStartOf="@+id/tvCourseTitle"
                    app:layout_constraintTop_toBottomOf="@+id/tvCourseTitle"
                    tools:text="Author name" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvCourseCategory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_2"
                    android:text="@{coupon.category}"
                    android:textColor="@color/m3_primary"
                    android:textSize="@dimen/text_size_body_small"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/tvCourseAuthor"
                    app:layout_constraintStart_toStartOf="@+id/tvCourseAuthor"
                    app:layout_constraintTop_toBottomOf="@+id/tvCourseAuthor"
                    tools:text="Development" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvRatingValue"
                    app:displayRatingValue="@{coupon.rating}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_6"
                    android:textColor="@color/golden"
                    android:textSize="@dimen/text_size_body_small"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/rbCourse"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/rbCourse"
                    tools:text="4.2" />

                <RatingBar
                    android:id="@+id/rbCourse"
                    style="@style/Widget.AppCompat.RatingBar.Small"
                    app:displayRating="@{coupon.rating}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:layout_marginTop="@dimen/spacing_2"
                    android:numStars="5"
                    android:theme="@style/rating_bar"
                    app:layout_constraintStart_toEndOf="@+id/tvRatingValue"
                    app:layout_constraintTop_toBottomOf="@+id/tvCourseCategory" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivStudents"
                    android:layout_width="@dimen/spacing_12"
                    android:layout_height="@dimen/spacing_12"
                    android:layout_marginTop="@dimen/spacing_2"
                    android:src="@drawable/ic_students"
                    app:layout_constraintStart_toStartOf="@+id/tvRatingValue"
                    app:layout_constraintTop_toBottomOf="@+id/rbCourse"
                    app:tint="@color/m3_on_surface_variant" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvNumberOfStudent"
                    app:displayNumberOfStudents="@{coupon.students}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="@dimen/text_size_label_small"
                    app:layout_constraintBottom_toBottomOf="@+id/ivStudents"
                    app:layout_constraintStart_toEndOf="@+id/ivStudents"
                    app:layout_constraintTop_toTopOf="@+id/ivStudents"
                    tools:text="2k" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivReviews"
                    android:layout_width="@dimen/spacing_12"
                    android:layout_height="@dimen/spacing_12"
                    android:layout_marginStart="@dimen/spacing_10"
                    android:src="@drawable/ic_comment"
                    app:layout_constraintBottom_toBottomOf="@+id/ivStudents"
                    app:layout_constraintStart_toEndOf="@+id/tvNumberOfStudent"
                    app:layout_constraintTop_toTopOf="@+id/ivStudents"
                    app:tint="@color/m3_on_surface_variant" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvNumberOfReviews"
                    app:displayNumberOfReviews="@{coupon.reviews}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:includeFontPadding="false"
                    android:layout_marginBottom="@dimen/spacing_6"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="@dimen/text_size_label_small"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivReviews"
                    app:layout_constraintTop_toTopOf="@+id/ivReviews"
                    tools:text="452" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
