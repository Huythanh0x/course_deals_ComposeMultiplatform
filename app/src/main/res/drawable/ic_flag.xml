<?xml version="1.0" encoding="utf-8"?>
<!--
  Flag / Report — state selector
  state_selected=true → filled/error (report active)
  default             → outlined (no report)
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true"  android:drawable="@drawable/ic_flag_filled"/>
    <item android:state_checked="true"   android:drawable="@drawable/ic_flag_filled"/>
    <item                                android:drawable="@drawable/ic_flag_outlined"/>
</selector>
