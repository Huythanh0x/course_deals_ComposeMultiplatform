<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <FrameLayout
        android:id="@+id/flProfileContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsvProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/m3_surface_container_low"
            android:clickable="true"
            android:fillViewport="true"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clProfileRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingBottom="@dimen/spacing_32">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/lpSync"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible" />

                <!-- Header -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvAvatar"
                    android:layout_width="@dimen/spacing_64"
                    android:layout_height="@dimen/spacing_64"
                    android:layout_marginTop="@dimen/spacing_32"
                    app:cardBackgroundColor="@color/m3_primary_container"
                    app:cardCornerRadius="@dimen/spacing_32"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeWidth="0dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/spacing_16"
                        android:src="@drawable/ic_nav_profile"
                        app:tint="@color/m3_on_primary_container" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvDisplayName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:text="User Name"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cvAvatar" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/llEmailContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_4"
                    app:layout_constraintEnd_toEndOf="@+id/tvDisplayName"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="@+id/tvDisplayName"
                    app:layout_constraintTop_toBottomOf="@+id/tvDisplayName">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="user@example.com"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btnCopyEmail"
                        android:layout_width="@dimen/spacing_18"
                        android:layout_height="@dimen/spacing_18"
                        android:src="@drawable/ic_content_copy"
                        app:layout_constraintBottom_toBottomOf="@+id/tvEmail"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tvEmail"
                        app:layout_constraintTop_toTopOf="@+id/tvEmail" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Favorite Categories -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvFavCatsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_16"
                    android:layout_marginTop="@dimen/spacing_32"
                    android:text="@string/fav_cats_title"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/llEmailContainer" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgFavCats"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_16"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:clipToPadding="false"
                    android:paddingVertical="@dimen/spacing_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvFavCatsTitle">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btnAddCat"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipBackgroundColor="@android:color/transparent"
                        app:chipEndPadding="@dimen/spacing_10"
                        app:chipIcon="@drawable/ic_add"
                        app:chipIconSize="@dimen/icon_size_medium"
                        app:chipIconTint="?attr/colorOnSurfaceVariant"
                        app:chipIconVisible="true"
                        app:chipStartPadding="@dimen/spacing_10"
                        app:chipStrokeWidth="@dimen/spacing_1"
                        app:iconEndPadding="0dp"
                        app:iconStartPadding="0dp"
                        app:textEndPadding="0dp"
                        app:textStartPadding="0dp" />

                </com.google.android.material.chip.ChipGroup>

                <!-- Favorite Keywords -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvFavKwsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_16"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:text="@string/fav_kws_title"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cgFavCats" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilKeyword"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_16"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:visibility="gone"
                    app:endIconDrawable="@drawable/ic_add"
                    app:endIconMode="custom"
                    app:endIconTint="?attr/colorOnSurfaceVariant"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvFavKwsTitle"
                    tools:visibility="visible">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tietKeyword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/kw_hint"
                        android:imeOptions="actionDone"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgFavKws"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_16"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:clipToPadding="false"
                    android:paddingVertical="@dimen/spacing_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tilKeyword">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btnAddKw"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipBackgroundColor="@android:color/transparent"
                        app:chipEndPadding="@dimen/spacing_10"
                        app:chipIcon="@drawable/ic_add"
                        app:chipIconSize="@dimen/icon_size_medium"
                        app:chipIconTint="?attr/colorOnSurfaceVariant"
                        app:chipIconVisible="true"
                        app:chipStartPadding="@dimen/spacing_10"
                        app:chipStrokeWidth="@dimen/spacing_1"
                        app:iconEndPadding="0dp"
                        app:iconStartPadding="0dp"
                        app:textEndPadding="0dp"
                        app:textStartPadding="0dp" />

                </com.google.android.material.chip.ChipGroup>

                <!-- Settings -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvSettingsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_16"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:text="@string/settings_title"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cgFavKws" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swEnableDarkMode"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spacing_58"
                    android:layout_marginHorizontal="@dimen/spacing_16"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:paddingHorizontal="@dimen/spacing_16"
                    android:text="@string/enable_dark_mode_switch_text"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    app:layout_constraintTop_toBottomOf="@+id/tvSettingsTitle" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swEnableFingerPrint"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spacing_58"
                    android:layout_marginHorizontal="@dimen/spacing_16"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:paddingHorizontal="@dimen/spacing_16"
                    android:text="@string/enable_finger_print_switch_text"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    app:layout_constraintTop_toBottomOf="@+id/swEnableDarkMode" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swEnableNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spacing_58"
                    android:layout_marginHorizontal="@dimen/spacing_16"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:paddingHorizontal="@dimen/spacing_16"
                    android:text="@string/notif_master"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    app:layout_constraintTop_toBottomOf="@+id/swEnableFingerPrint" />

                <!-- Sub-toggles for Notifications -->
                <LinearLayout
                    android:id="@+id/llNotificationSubSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_16"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@+id/swEnableNotifications"
                    tools:visibility="visible">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swNotifCat"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/spacing_48"
                        android:layout_marginStart="@dimen/spacing_40"
                        android:paddingHorizontal="@dimen/spacing_16"
                        android:text="@string/notif_cat"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swNotifKw"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/spacing_48"
                        android:layout_marginStart="@dimen/spacing_40"
                        android:paddingHorizontal="@dimen/spacing_16"
                        android:text="@string/notif_kw"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swNotifHot"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/spacing_48"
                        android:layout_marginStart="@dimen/spacing_40"
                        android:paddingHorizontal="@dimen/spacing_16"
                        android:text="@string/notif_hot"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />
                </LinearLayout>

                <!-- Logout -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_16"
                    android:layout_marginTop="@dimen/spacing_48"
                    android:text="@string/logout_button_text"
                    android:textColor="@color/m3_on_error_container"
                    app:cornerRadius="@dimen/corner_radius_large"
                    app:layout_constraintTop_toBottomOf="@+id/llNotificationSubSettings"
                    app:strokeColor="@color/m3_on_error_container"
                    app:strokeWidth="@dimen/spacing_2" />

                <!-- Footer -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDevEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_32"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="@dimen/spacing_8"
                    android:paddingVertical="@dimen/spacing_4"
                    android:text="@string/dev_email"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/m3_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btnLogout" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDevWebsite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="@dimen/spacing_8"
                    android:paddingVertical="@dimen/spacing_4"
                    android:text="@string/dev_website"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/m3_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvDevEmail" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Guest Mode Auth Gate Overlay -->
        <FrameLayout
            android:id="@+id/flGuestOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#88000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="@dimen/spacing_24"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="@dimen/spacing_28"
                app:cardElevation="@dimen/spacing_8"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_24"
                    android:paddingVertical="@dimen/spacing_32">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/spacing_58"
                        android:layout_height="@dimen/spacing_58"
                        android:src="@drawable/ic_nav_profile"
                        app:tint="?attr/colorPrimary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:text="@string/guest_profile_auth_gate_title"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:gravity="center"
                        android:text="@string/guest_profile_auth_gate_message"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSignIn"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/spacing_48"
                        android:layout_marginTop="@dimen/spacing_24"
                        android:text="@string/sign_in_cta"
                        app:cornerRadius="@dimen/spacing_24" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

    </FrameLayout>
</layout>
