<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/spacing_8">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:id="@+id/dragHandle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_24"
            android:text="@string/filter_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dragHandle" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsvFilterContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingHorizontal="@dimen/spacing_24"
            android:paddingBottom="@dimen/spacing_16"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/footerDivider"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            app:layout_constraintVertical_bias="0.0">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Category Section -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvCategoryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:text="@string/fav_cats_title"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    app:layout_constraintTop_toBottomOf="@+id/tvCategoryLabel">
                    <!-- Category items will be inflated here -->
                </com.google.android.material.chip.ChipGroup>

                <!-- Rating Section -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvRatingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:text="@string/filter_rating"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cgCategories" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvCurrentRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/golden"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/tvRatingLabel"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvRatingLabel"
                    tools:text="4.5+ Stars" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderRating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:stepSize="1.0"
                    android:valueFrom="0.0"
                    android:valueTo="11.0"
                    app:layout_constraintTop_toBottomOf="@+id/tvRatingLabel"
                    app:thumbColor="@color/golden"
                    app:trackColorActive="@color/golden"
                    app:trackColorInactive="@color/m3_outline_variant"
                    app:tickVisible="true"
                    app:tickColorActive="@color/golden"
                    app:tickColorInactive="@color/m3_outline_variant" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_rating_any"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:alpha="0.7"
                    app:layout_constraintStart_toStartOf="@+id/sliderRating"
                    app:layout_constraintTop_toBottomOf="@+id/sliderRating" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_rating_max"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:alpha="0.7"
                    app:layout_constraintEnd_toEndOf="@+id/sliderRating"
                    app:layout_constraintTop_toBottomOf="@+id/sliderRating" />

                <!-- Language Section -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvLanguageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:text="@string/lang_label"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/sliderRating" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgLanguages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    app:layout_constraintTop_toBottomOf="@+id/tvLanguageLabel"
                    app:singleSelection="true">
                    <!-- Language items will be inflated here -->
                </com.google.android.material.chip.ChipGroup>

                <!-- Sort Section -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvSortLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:text="@string/sort_label"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cgLanguages" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgSort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:paddingBottom="@dimen/spacing_16"
                    app:layout_constraintTop_toBottomOf="@+id/tvSortLabel"
                    app:singleSelection="true">
                    <!-- Sort items will be inflated here -->
                </com.google.android.material.chip.ChipGroup>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <View
            android:id="@+id/footerDivider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_1"
            android:background="?attr/colorOutlineVariant"
            app:layout_constraintBottom_toTopOf="@+id/llActionFooter" />

        <LinearLayout
            android:id="@+id/llActionFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_24"
            android:paddingVertical="@dimen/spacing_16"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_reset" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApply"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_16"
                android:layout_weight="1"
                android:text="@string/filter_apply" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
